{
  "manifest_version": 3,
  "name": "__MSG_nom__",
  "short_name": "DefileShorts",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "description": "__MSG_description__",
  "default_locale": "fr",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_nom__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["arriere-plan.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defile.js"],
      "run_at": "document_idle"
    }
  ]
}
